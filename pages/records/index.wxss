.records-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #f7f7fb;
}

.records-hero {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 240px;
  background: linear-gradient(180deg, #eeebff 0%, #f6f5fc 70%, #f7f7fb 100%);
  pointer-events: none;
}

.records-scroll {
  position: relative;
  z-index: 1;
  height: calc(100vh - 82px);
  padding-bottom: 100px;
}

.status-space {
  width: 100%;
}

.top-bar {
  display: flex;
  height: 56px;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
}

.brand-lockup {
  display: flex;
  align-items: center;
}

.brand-mark {
  position: relative;
  width: 28px;
  height: 28px;
  margin-right: 9px;
  border-radius: 9px;
  background: #6554e8;
}

.brand-mark__bubble {
  position: absolute;
  top: 8px;
  left: 7px;
  width: 14px;
  height: 10px;
  border: 1.5px solid #fff;
  border-radius: 2px;
}

.brand-mark__bubble::after {
  position: absolute;
  bottom: -4px;
  left: 2px;
  width: 5px;
  height: 5px;
  border-bottom: 1.5px solid #fff;
  border-left: 1.5px solid #fff;
  content: '';
  transform: skewY(-38deg);
}

.brand-mark__line {
  position: absolute;
  left: 10px;
  width: 9px;
  height: 1px;
  border-radius: 1px;
  background: #fff;
}

.brand-mark__line--top {
  top: 12px;
}

.brand-mark__line--bottom {
  top: 16px;
}

.brand-name {
  color: #202235;
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.3px;
}

.native-capsule-space {
  width: 88px;
  height: 31px;
}

.records-heading {
  padding: 24px 20px 18px;
}

.records-heading__row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.records-title {
  display: block;
  color: #202235;
  font-size: 26px;
  font-weight: 600;
  letter-spacing: -0.8px;
}

.records-subtitle {
  display: block;
  margin-top: 5px;
  color: #55596f;
  font-size: 12px;
}

.new-record-button {
  display: flex;
  align-items: center;
  height: 36px;
  margin: 0;
  padding: 0 13px;
  border: 1px solid #d9d1fc;
  border-radius: 11px;
  background: #fff;
  color: #6554e8;
  font-size: 12px;
  font-weight: 600;
  line-height: 36px;
}

.new-record-button__plus {
  margin-right: 5px;
  font-size: 19px;
  font-weight: 300;
  line-height: 1;
}

.records-summary {
  display: flex;
  align-items: center;
  margin-top: 18px;
  color: #8a8da1;
  font-size: 11px;
}

.records-sync-status {
  display: block;
  margin-top: 7px;
  color: #8a8da1;
  font-size: 10px;
  line-height: 1.5;
}

.records-sync-status--success {
  color: #4c9a77;
}

.records-sync-status--pending,
.records-sync-status--error {
  color: #b77c49;
}

.summary-dot {
  width: 7px;
  height: 7px;
  margin-right: 7px;
  border-radius: 50%;
  background: #6554e8;
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 10px 20px 24px;
  padding: 42px 28px 34px;
  border: 1px dashed #ddd8f8;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.68);
  text-align: center;
}

.empty-state__icon {
  position: relative;
  width: 90px;
  height: 78px;
  margin-bottom: 17px;
  border-radius: 25px;
  background: #f0edff;
}

.empty-state__car,
.record-cover__car {
  position: absolute;
  top: 29px;
  left: 19px;
  width: 50px;
  height: 25px;
  border: 2px solid #a29cb9;
  border-radius: 15px 15px 7px 7px;
}

.empty-state__car::before,
.record-cover__car::before {
  position: absolute;
  top: -12px;
  left: 11px;
  width: 24px;
  height: 15px;
  border: 2px solid #a29cb9;
  border-bottom: 0;
  border-radius: 12px 12px 0 0;
  content: '';
}

.empty-state__car::after,
.record-cover__car::after {
  position: absolute;
  bottom: -7px;
  left: 4px;
  width: 8px;
  height: 8px;
  border: 2px solid #a29cb9;
  border-radius: 50%;
  background: #fff;
  box-shadow: 30px 0 0 -2px #fff, 30px 0 0 0 #a29cb9;
  content: '';
}

.empty-state__plus,
.record-cover__plus {
  position: absolute;
  right: 11px;
  bottom: 8px;
  width: 25px;
  height: 25px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: #6554e8;
  color: #fff;
  font-size: 22px;
  font-weight: 300;
  line-height: 18px;
  text-align: center;
}

.empty-state__title {
  color: #202235;
  font-size: 16px;
  font-weight: 600;
}

.empty-state__desc {
  max-width: 250px;
  margin-top: 7px;
  color: #8a8da1;
  font-size: 11px;
  line-height: 1.6;
}

.empty-state__button {
  width: 180px;
  height: 44px;
  margin-top: 22px;
  border-radius: 13px;
  background: #6554e8;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  line-height: 44px;
}

.record-list {
  padding: 0 20px 24px;
}

.record-card {
  margin-bottom: 12px;
  padding: 14px;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 3px 0 #eeeeF6;
}

.record-card__top {
  display: flex;
}

.record-cover {
  position: relative;
  flex: 0 0 82px;
  width: 82px;
  height: 82px;
  margin-right: 12px;
  overflow: hidden;
  border-radius: 13px;
  background: #f0edff;
}

.record-cover--image {
  background: #f7f7fc;
}

.record-cover__image {
  width: 100%;
  height: 100%;
}

.record-cover__car {
  top: 38px;
  left: 16px;
  transform: scale(0.9);
}

.record-cover__plus {
  right: 4px;
  bottom: 4px;
  width: 22px;
  height: 22px;
  font-size: 19px;
  line-height: 16px;
}

.record-card__content {
  flex: 1;
  min-width: 0;
}

.record-card__title-row,
.record-card__progress-row,
.record-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-card__title-row {
  gap: 8px;
}

.record-card__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #202235;
  font-size: 14px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-card__actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 7px;
}

.record-card__status {
  flex: 0 0 auto;
  padding: 4px 7px;
  border-radius: 7px;
  background: #f0edff;
  color: #6554e8;
  font-size: 9px;
}

.delete-record-button {
  display: flex;
  align-items: center;
  height: 22px;
  margin: 0;
  padding: 0 2px;
  border: 0;
  background: transparent;
  color: #b5a0a6;
  font-size: 10px;
  line-height: 22px;
}

.record-card__date {
  display: block;
  margin-top: 5px;
  color: #8a8da1;
  font-size: 10px;
}

.record-card__sync-row {
  margin-top: 5px;
}

.record-card__sync-label {
  display: inline-block;
  padding: 2px 5px;
  border-radius: 5px;
  font-size: 9px;
}

.record-card__sync-label--cloud {
  background: #e9f7ef;
  color: #4c9a77;
}

.record-card__sync-label--local {
  background: #fff3e7;
  color: #b77c49;
}

.record-card__points {
  margin-top: 8px;
  padding: 7px 8px;
  border-radius: 8px;
  background: #faf9ff;
}

.record-card__points-title {
  display: block;
  color: #8a8da1;
  font-size: 9px;
}

.record-card__points-value {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: #55596f;
  font-size: 10px;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-card__points-value--empty {
  color: #b2b2c1;
}

.record-card__progress-row {
  margin-top: 13px;
  color: #55596f;
  font-size: 10px;
}

.record-card__progress-label {
  color: #6554e8;
  font-weight: 600;
}

.record-progress {
  height: 5px;
  margin-top: 6px;
  overflow: hidden;
  border-radius: 3px;
  background: #f0edff;
}

.record-progress__value {
  height: 100%;
  border-radius: 3px;
  background: #6554e8;
}

.record-card__bottom {
  margin-top: 13px;
  padding-top: 11px;
  border-top: 1px solid #f0eff5;
}

.record-card__hint {
  overflow: hidden;
  color: #8a8da1;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-button {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  height: 30px;
  margin: 0;
  padding: 0 10px 0 12px;
  border-radius: 9px;
  background: #6554e8;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  line-height: 30px;
}

.continue-button__arrow {
  margin-left: 5px;
  font-size: 18px;
  font-weight: 300;
  line-height: 12px;
}

.records-bottom-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 82px;
  padding: 12px 20px 4px;
  background: #fff;
  box-shadow: 0 -1px 0 #eaeaf2;
}

.records-bottom-bar__button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 44px;
  margin: 0;
  border-radius: 13px;
  background: #6554e8;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  line-height: 44px;
}

.records-bottom-bar__plus {
  margin-right: 7px;
  font-size: 20px;
  font-weight: 300;
  line-height: 1;
}

.home-indicator {
  width: 132px;
  height: 4px;
  margin: 10px auto 0;
  border-radius: 2px;
  background: #202235;
}
